# Host directory for the account copies, the restic repository, the tokens and the state. Must exist.
DATA_DIR=/srv/cloud-drive-backup

# Sources: names of your choice, space-separated; lower-case letters, digits and _, starting with a letter. A source
# is an account, a folder in one, a Google shared drive or a Google "Shared with me". Each source <name> has the
# settings <NAME>_* below; sign it in once with `docker exec -it cloud-drive-backup backup.sh auth <name>`.
SOURCES=gdrive gdrive_team gdrive_others dropbox yadisk

# Per source:
#   <NAME>_TYPE            drive (Google Drive), dropbox or yandex (Yandex Disk) (required)
#   <NAME>_ROOT            only this folder of the account; empty = all of it
#   <NAME>_ACCOUNT         sign-in shared with the source of that name (same TYPE); default: the source's own
#   <NAME>_SHARED_DRIVE    drive only: the id of a shared drive instead of My Drive (backup.sh drives <name>)
#   <NAME>_SHARED_WITH_ME  drive only: yes = the files shared with the account instead of My Drive; default no
#   <NAME>_MAX_DELETE      a run deletes at most this percent of the files in the copy; default MAX_DELETE
#   <NAME>_SCHEDULE        cron schedule; default SCHEDULE
#   <NAME>_KEEP_HOURLY, _KEEP_DAILY, _KEEP_WEEKLY, _KEEP_MONTHLY   retention; default the global KEEP_*
#   <NAME>_RCLONE_FLAGS    extra rclone flags; default RCLONE_FLAGS
GDRIVE_TYPE=drive
GDRIVE_TEAM_TYPE=drive
GDRIVE_TEAM_ACCOUNT=gdrive
GDRIVE_TEAM_SHARED_DRIVE=0ABCdefGHIjklUk9PVA
GDRIVE_OTHERS_TYPE=drive
GDRIVE_OTHERS_ACCOUNT=gdrive
GDRIVE_OTHERS_SHARED_WITH_ME=yes
DROPBOX_TYPE=dropbox
YADISK_TYPE=yandex
YADISK_SCHEDULE=0 5 * * *

# Default cron schedule and the time zone of all schedules.
SCHEDULE=30 4 * * *
TZ=UTC

# A run that would delete more than this percentage of the files in the copy of a source leaves the copy and fails
# (whole number, 0-100; 100 = no limit). Rounded down: with fewer than ten files one deletion is already too many.
MAX_DELETE=10

# Default snapshot retention. With a schedule more often than daily, KEEP_HOURLY keeps that many hourly snapshots.
KEEP_HOURLY=0
KEEP_DAILY=30
KEEP_WEEKLY=8
KEEP_MONTHLY=24
# restic check on this weekday (1 = Monday, 7 = Sunday; empty = never), reading this share of the data.
CHECK_WEEKDAY=7
CHECK_READ_SUBSET=10%

# Extra rclone flags for every source, e.g. --bwlimit 10M or --drive-export-formats odt,ods,odp. Space-separated, no
# quoting. They apply to the listing too; --dump, --log-file, --config and -P (--progress) are refused. RCLONE_*
# variables here don't reach rclone.
RCLONE_FLAGS=

# Host name of the snapshots; retention only touches snapshots with this one, so don't change it later.
SNAPSHOT_HOST=cloud-drive-backup

# Optional off-host copy of the restic repository, rsync over SSH. Empty = off. user@host:path, colon required.
# Key: secrets/copy_ssh_key, host key: secrets/copy_known_hosts.
COPY_TARGET=
# COPY_TARGET=bkcopy@backup-host.example:
COPY_PORT=22
# COPY_KEY_FILE=/run/secrets/copy_ssh_key
# COPY_KNOWN_HOSTS_FILE=/run/secrets/copy_known_hosts
